  residential: { USD: 999 },
  commercial: { USD: 2999 }
};

const GOOGLE_MAPS_KEY = 'AIzaSyCy8dLaE-dKx_sp-6AZaiHgSLAboMyTd1w';
const usedPromoEmails = new Set();

function detectLanguage(text) {
  return /[\u4e00-\u9fa5]/.test(text) ? 'zh' : 'en';
}

async function intelligentUnderstanding(query) {
  try {
    const message = await anthropic.messages.create({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 300,
      temperature: 0,
      messages: [{ role: 'user', content: `分析查询："${query}"\n\n返回JSON格式：\n{"understood":true/false,"location":"具体地点（英文）","business":"业态类型","intent":"analysis/recommendation"}\n\n只返回JSON，不要其他内容。` }],
    });
    return JSON.parse(message.content[0].text.trim().replace(/```json|```/g, '').trim());
  } catch (error) {
    return { understood: false };
  }
}

async function getGoogleMapsInfo(location) {
  try {
    const response = await axios.get('https://maps.googleapis.com/maps/api/place/textsearch/json', {
      params: { query: location, key: GOOGLE_MAPS_KEY }, timeout: 10000
    });
    if (response.data.results?.[0]) {
      const place = response.data.results[0];
      const details = await axios.get('https://maps.googleapis.com/maps/api/place/details/json', {
        params: { place_id: place.place_id, fields: 'formatted_address,geometry', key: GOOGLE_MAPS_KEY }, timeout: 10000
      });
      return {
        address: details.data.result.formatted_address,
        lat: details.data.result.geometry.location.lat,
        lng: details.data.result.geometry.location.lng
      };
    }
  } catch (error) {}
  return { address: location, lat: 40.7589, lng: -73.9851 };
}

async function getNearbyPlaces(lat, lng) {
  try {
    const response = await axios.get('https://maps.googleapis.com/maps/api/place/nearbysearch/json', {
      params: { location: `${lat},${lng}`, radius: 2000, type: 'establishment', key: GOOGLE_MAPS_KEY }, timeout: 10000
    });
    return response.data.results?.slice(0, 12) || [];
  } catch (error) {
    return [];
  }
}

async function generatePDF(reportData, reportText) {
  return new Promise((resolve, reject) => {
    try {
      const fileName = `PropertyIQ-${reportData.reportId}.pdf`;
      const filePath = path.join('/tmp', fileName);
      const doc = new PDFDocument({ margin: 50, size: 'A4' });
      const writeStream = fs.createWriteStream(filePath);
      
      doc.pipe(writeStream);
      
      // 封面
      doc.fontSize(28).fillColor('#0ea5e9').text('PropertyIQ', { align: 'center' });
      doc.fontSize(16).fillColor('#666').text('Professional Property Analysis Report', { align: 'center' });
      doc.moveDown(2);
      
      // 报告信息盒子
      doc.fontSize(11).fillColor('#000');
      const boxY = doc.y;
      doc.rect(50, boxY, 495, 100).fillAndStroke('#f0f9ff', '#0ea5e9');
      doc.fillColor('#000').text(`Report ID: ${reportData.reportId}`, 70, boxY + 20);
      doc.text(`Address: ${reportData.address}`, 70, boxY + 40);
      doc.text(`Analysis Date: ${reportData.date}`, 70, boxY + 60);
      doc.text(`Report Type: ${reportData.type || 'Commercial'}`, 70, boxY + 80);
      
      doc.moveDown(3);
      
      // 内容
      doc.fontSize(10).fillColor('#000');
      const lines = reportText.split('\n');
      
      for (let line of lines) {
        if (doc.y > 720) doc.addPage();
        
        // 标题格式化
        if (line.startsWith('# ')) {
          doc.moveDown().fontSize(18).fillColor('#0ea5e9').text(line.replace('# ', ''), { underline: true });
          doc.fontSize(10).fillColor('#000').moveDown(0.5);
        } else if (line.startsWith('## ')) {
          doc.moveDown().fontSize(14).fillColor('#2563eb').text(line.replace('## ', ''));
          doc.fontSize(10).fillColor('#000').moveDown(0.3);
        } else if (line.startsWith('### ')) {
          doc.moveDown(0.5).fontSize(12).fillColor('#000').text(line.replace('### ', ''), { bold: true });
          doc.fontSize(10).moveDown(0.2);
        } else if (line.trim()) {
          doc.text(line, { align: 'left', lineGap: 2 });
        } else {
          doc.moveDown(0.3);
        }
      }
      
      // 页脚
      const pageCount = doc.bufferedPageRange().count;
      for (let i = 0; i < pageCount; i++) {
        doc.switchToPage(i);
        doc.fontSize(8).fillColor('#999').text(
          `Page ${i + 1} of ${pageCount} | © 2026 PropertyIQ - propertyiq.space`,
          50, 770, { align: 'center' }
        );
      }
      
      doc.end();
      writeStream.on('finish', () => resolve(filePath));
      writeStream.on('error', reject);
    } catch (error) {
      reject(error);
    }
  });
}

