    });

    try { fs.unlinkSync(pdfPath); } catch (err) {}

    if (error) {
      console.error('❌ Email error:', error);
      return false;
    }

    console.log('✅ Email sent!');
    return true;
  } catch (error) {
    console.error('❌ Email failed:', error);
    return false;
  }
