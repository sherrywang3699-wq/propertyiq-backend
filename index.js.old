  res.json({ 
    status: 'running', 
    version: 'PROFESSIONAL v2.0', 
    features: ['async-email', 'premium-reports', '20-25-pages'],
    domain: 'propertyiq.space',
    timestamp: new Date().toISOString() 
  });
});

