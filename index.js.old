app.post('/api/verify-location', async (req, res) => {
  try {
    const { address } = req.body;
    if (!address) return res.json({ valid: false, suggestion: 'Please enter a location or business question' });
    
    const understanding = await intelligentUnderstanding(address);
    
    if (!understanding.understood) {
      return res.json({ valid: false, suggestion: 'Please be more specific about the location or business type' });
    }
    
    res.json({ valid: true, address: understanding.location, coordinates: { lat: 40, lng: -73 } });
  } catch (error) {
    res.json({ valid: false, suggestion: 'Verification error. Please try again.' });
  }
});

app.post('/api/create-checkout', async (req, res) => {
  try {
    const { type, address, email, promoCode } = req.body;
    
    console.log('🎫 Promo:', promoCode);
    
    if (promoCode && promoCode.toUpperCase() === 'PRODUCTHUNT') {
      if (email) {
        const key = `${email.toLowerCase()}_PRODUCTHUNT`;
        if (usedPromoEmails.has(key)) {
          return res.status(400).json({ error: 'This promo code has already been used with this email' });
        }
        usedPromoEmails.add(key);
      }
      
      return res.json({ 
        url: `https://propertyiq-ai.vercel.app/?success=true&session_id=free_${Date.now()}&address=${encodeURIComponent(address)}&type=${type}&email=${encodeURIComponent(email || '')}`
      });
    }
    
    const sessionConfig = {
      payment_method_types: ['card'],
      customer_email: email || undefined,
      line_items: [{ 
        price_data: { 
          currency: 'usd', 
          product_data: { 
            name: `PropertyIQ ${type === 'commercial' ? 'Commercial' : 'Residential'} Analysis`, 
            description: address 
          }, 
          unit_amount: PRICING[type].USD 
        }, 
        quantity: 1 
      }],
      mode: 'payment',
      success_url: `https://propertyiq-ai.vercel.app/?success=true&session_id={CHECKOUT_SESSION_ID}&address=${encodeURIComponent(address)}&type=${type}&email=${encodeURIComponent(email || '')}`,
      cancel_url: `https://propertyiq-ai.vercel.app/`,
      metadata: { address, type, email: email || 'none' }
    };

    const session = await stripe.checkout.sessions.create(sessionConfig);
    res.json({ url: session.url });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

